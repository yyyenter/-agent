# 飞书集成配置示例
# 将以下配置添加到 .env 文件中

# 飞书应用配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret_here

# Webhook 验证配置（在飞书开放平台配置）
FEISHU_VERIFY_TOKEN=your_verify_token_here
FEISHU_ENCRYPT_KEY=your_encrypt_key_here

# 飞书机器人回调 URL（部署后配置到飞书开放平台）
# FEISHU_WEBHOOK_URL=https://your-domain.com/api/feishu/webhook
